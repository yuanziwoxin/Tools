# ---------- AI Coding Tools ----------
# Cursor
.cursorignore

# Windsurf (Codeium)
.codeiumignore
.windsurf/

# Claude Code
# Ignore user-specific/local files but keep shared assets if desired
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
CLAUDE.local.md

# Qwen Code
.qwenignore

# Tongyi Lingma (Alibaba Cloud)
# Project rules can be shared via git; uncomment below if you prefer local-only rules
# .lingma/rules/

# Trae (ByteDance)
.trae/
# .trae/.ignore is usually auto-generated; whole directory ignored by default

# Generic AI ignore files
.agentignore
.aiignore

# ---------- Misc ----------
.DS_Store
*.bak
*.orig
*.rej
*.tmp
*.temp
*.swp
*.swo

# ---------- Local config files (keep as needed) ----------
*.local
local.properties
config.local.*
application-local.*
application-*.local.*

# ---------- AI Coding Tools ----------
# Cursor
.cursorignore

# Windsurf (Codeium)
.codeiumignore
.windsurf/

# Claude Code
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
CLAUDE.local.md

# Qwen Code
.qwenignore

# Tongyi Lingma (Alibaba Cloud)
# .lingma/rules/

# Trae (ByteDance)
.trae/

# Codex (OpenAI)
# Project-specific: agents and config are usually local/machine-specific
.codex/agents/
.codex/config.toml
.codex/hooks.json
# AGENTS.override.md is explicitly local/uncommitted [citation:9]
AGENTS.override.md
# Note: .agents/skills/ is a SHARED directory used by multiple AI tools.
# Do NOT ignore it wholesale; it may contain project-committed skills.

# CodeBuddy / WorkBuddy
# Project-level config lives in .codebuddy/ and is intended for team sharing [citation:2][citation:3]
# However, local personal overrides should be ignored.
.codebuddy/settings.local.json
# Uncomment the line below if you prefer to keep ALL .codebuddy rules local-only
# .codebuddy/
.workbuddy/

# DeepSeek Harness
# User data lives in ~/.dsh (outside project), but any local harness state
# in the project should be ignored. No confirmed project-level dir name.
.dsh/
# Generic fallback if harness writes a local state dir
.dsh-local/

# Generic AI ignore files
.agentignore
.aiignore
